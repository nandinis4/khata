<?xml version="1.0" encoding="utf-8"?>
<!--
  Everything is excluded, deliberately.

  Android's cloud backup and device-transfer would otherwise copy the ledger off
  the phone as a side effect of a system feature the user never associated with
  this app. Exporting is a thing the user does on purpose here, not something
  that happens to them.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
